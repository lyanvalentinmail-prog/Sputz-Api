# ─── SiputZX API — Variables de entorno ───────────────────────────────
# Copia este archivo a `.env` y completa solo lo que necesites.
# Ninguna clave es obligatoria para arrancar el servidor: los endpoints
# que dependan de una credencial ausente se marcarán como no disponibles.

# Nombre público de la API (cámbialo para renombrar toda la web)
API_NAME=SiputZX API

# Puerto del backend
PORT=3001

# ─── Límites de uso ────────────────────────────────────────────────────
# Solicitudes por ventana y tamaño de ventana (ms) para el rate limit
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Tamaño máximo de subida (MB)
MAX_UPLOAD_MB=25

# ─── Herramientas externas (opcionales) ────────────────────────────────
# Rutas absolutas a binarios; si se omiten se intentan usar los incluidos
# vía npm (@ffmpeg-installer/ffmpeg) o el PATH del sistema (yt-dlp).
FFMPEG_PATH=
YTDLP_PATH=

# ─── Proveedores de IA (opcionales) ────────────────────────────────────
OPENAI_API_KEY=
# Blackbox se configura como proveedor compatible con OpenAI
BLACKBOX_API_KEY=
BLACKBOX_BASE_URL=
# remove.bg
REMOVEBG_API_KEY=

# ─── Búsqueda (opcionales) ─────────────────────────────────────────────
# Google Custom Search JSON API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Google Cloud Vision (búsqueda inversa de imágenes)
GOOGLE_VISION_API_KEY=

# ─── Música (opcionales) ───────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=

# ─── Enlaces cortos (opcionales) ───────────────────────────────────────
TINYURL_API_KEY=
